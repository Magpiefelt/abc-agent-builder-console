{
  "name": "abc-agent-builder-console",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Builder Console - GoA Enterprise Agentic Workflow Tool",
  "scripts": {
    "dev": "pnpm --parallel run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm --parallel run build",
    "lint": "pnpm --parallel run lint",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "type-check": "pnpm --recursive run type-check"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  }
}
