# Server
PORT=3000
NODE_ENV=development

# Database (Render shared PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DB_SCHEMA=cohen_mcleod

# Authentication (Microsoft Entra ID)
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret
ENTRA_TENANT_ID=your-tenant-id
ENTRA_REDIRECT_URI=http://localhost:3000/api/auth/callback
SESSION_SECRET=your-session-secret

# LLM Providers
VERTEX_AI_API_KEY=your-vertex-ai-key
ANTHROPIC_API_KEY=your-anthropic-key

# Tool API Keys (server-side only)
BRAVE_SEARCH_API_KEY=your-brave-key
GOOGLE_SEARCH_API_KEY=your-google-key
GOOGLE_SEARCH_CX=your-google-cx
ELEVENLABS_API_KEY=your-elevenlabs-key
GITHUB_TOKEN=your-github-token

# GoA Enterprise Tools (proxy for Brave search + image generation)
# When ENT_TOOLS_API_KEY is set, brave_search and image_generation route through this URL.
ENT_TOOLS_API_KEY=
ENT_TOOLS_BASE_URL=https://ent-tools.sandbox.aim.int.gov.ab.ca
# Override these if the Ent Tools proxy uses different paths.
ENT_TOOLS_BRAVE_PATH=/v1/brave/search
ENT_TOOLS_IMAGE_PATH=/v1/images/generations

# Email (SMTP) — send_email tool
# Use port 587 with STARTTLS (default) or 465 with EMAIL_SMTP_SECURE=true for implicit TLS.
# Replace the EMAIL_FROM with your department's approved sending address.
EMAIL_FROM=your-from-address@gov.ab.ca
EMAIL_SMTP_HOST=your-smtp-host
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-smtp-user
EMAIL_SMTP_PASS=your-smtp-pass
EMAIL_SMTP_SECURE=false

# API proxy allowlist (optional). Comma-separated hostnames. Supports `*.gov.ab.ca`.
# When unset, only SSRF blocks apply. When set, only listed hosts are reachable via get_call_api/post_call_api.
API_PROXY_ALLOWLIST=

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
