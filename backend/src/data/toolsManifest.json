          "repo": { "type": "string", "description": "Repository name" },
          "path": { "type": "string", "description": "Path within the repo (default: root)", "default": "" },
          "branch": { "type": "string", "description": "Branch name", "default": "main" }
        },
        "required": ["owner", "repo"]
      }
    },
    {
      "name": "read_github_file",
