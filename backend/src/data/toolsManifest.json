{
  "tools": [
    {
      "name": "brave_search",
      "category": "web_search",
      "description": "Search the web using Brave Search API. Returns relevant web results for a query.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "The search query" },
          "numResults": { "type": "number", "description": "Number of results to return (max 20)", "default": 10 }
        },
        "required": ["query"]
      }
    },
    {
      "name": "google_search",
      "category": "web_search",
      "description": "Search the web using Google Custom Search API. Returns relevant web results.",
      "parameters": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "The search query" },
          "numResults": { "type": "number", "description": "Number of results to return (max 10)", "default": 10 }
        },
        "required": ["query"]
      }
    },
    {
      "name": "web_scrape",
      "category": "web_scrape",
      "description": "Fetch and extract text content from a web page URL. Supports HTML, PDF, and DOCX.",
      "parameters": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "The URL to scrape" },
          "maxCharacters": { "type": "number", "description": "Maximum characters to return", "default": 50000 }
        },
        "required": ["url"]
      }
    },
    {
