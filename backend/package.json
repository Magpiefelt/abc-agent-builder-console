{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.1.0",
    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "pg": "^8.13.0",
    "dotenv": "^16.4.7",
    "zod": "^3.25.0",
    "uuid": "^11.1.0",
    "pdf-parse": "^1.1.1",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/adm-zip": "^0.5.5",
    "@types/supertest": "^6.0.2",
    "@testcontainers/postgresql": "^10.13.0",
    "@vitest/coverage-v8": "^3.1.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0",
    "eslint": "^9.0.0"
  }
}
